# Copy to .env and fill in. NEVER commit .env.

# IMAP (prefix = business_id in caps)
DEMO_SCHOOL_IMAP_HOST=mail.example.com
DEMO_SCHOOL_IMAP_PORT=993
DEMO_SCHOOL_IMAP_USER=user@example.com
DEMO_SCHOOL_IMAP_PASSWORD=change-me
DEMO_SCHOOL_IMAP_CERT_FINGERPRINT=AA:BB:CC:DD:EE:FF

# CallMeBot WhatsApp alerts
CALLMEBOT_PHONE=+15551234567
CALLMEBOT_APIKEY=change-me

# Optional: reply drafting
GEMINI_API_KEY=change-me
